# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True só no seu PC. No Raspberry Pi: False.
DEBUG=True

# Endereços pelos quais o site é acessado, separados por vírgula.
# No Pi inclua o IP da rede local e o IP/nome do Tailscale.
ALLOWED_HOSTS=localhost,127.0.0.1

# Necessário quando DEBUG=False e o acesso é por um endereço diferente de localhost.
# Exemplo: http://192.168.0.50:8000,http://bengala-pi:8000
CSRF_TRUSTED_ORIGINS=

# True só quando o site estiver atrás de HTTPS.
COOKIE_SEGURO=False

# Banco
# No PC (MariaDB): deixe DB_ENGINE vazio e DB_SSL=False.
# Na Vercel (TiDB Cloud): DB_ENGINE=django_tidb, DB_SSL=True e DB_PORT=4000.
DB_ENGINE=
DB_SSL=False
DB_NAME=bengala
DB_USER=api_bengala
DB_PASSWORD=senha-forte-aqui
DB_HOST=127.0.0.1
DB_PORT=3306
